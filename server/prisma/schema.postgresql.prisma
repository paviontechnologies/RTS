model CandidateCredential {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  candidateId        String       @map("candidate_id") @db.Uuid
  credentialType     String       @default("Certification") @map("credential_type") @db.VarChar(50)
  name               String       @db.VarChar(200)
  issuingAuthority   String?      @map("issuing_authority") @db.VarChar(200)
  credentialIdNumber String?      @map("credential_id_number") @db.VarChar(100)
  state              String       @default("National") @db.VarChar(50)
  issueDate          DateTime?    @map("issue_date") @db.Date
  expiryDate         DateTime?    @map("expiry_date") @db.Date
  verificationStatus String       @default("Verified") @map("verification_status") @db.VarChar(30)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate          Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_credentials")
  @@schema("compliance")
}

