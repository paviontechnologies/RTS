server/prisma/migrations_postgresql/*.sql linguist-language=SQL
scripts/*.sh linguist-language=Shell
templates/resumes/*.html linguist-language=HTML
templates/resumes/*.css linguist-language=CSS
providers/*.ts linguist-language=TypeScript
server/src/*.ts linguist-language=TypeScript
